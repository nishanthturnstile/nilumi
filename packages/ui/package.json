{
  "name": "@nilumi/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Nilumi design system: Pastel Rooms tokens, theme and shadcn/ui (Base UI) components.",
  "type": "module",
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./fonts": "./src/fonts.ts",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./components/ui/*": "./src/components/ui/*.tsx",
    "./components/nilumi/*": "./src/components/nilumi/*.tsx"
  },
  "scripts": {
    "contrast": "node scripts/check-contrast.mjs",
    "lint:classes": "node scripts/check-classes.mjs",
    "check": "node scripts/check-contrast.mjs && node scripts/check-classes.mjs && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "specimen": "tailwindcss -i specimen/specimen.css -o specimen/dist/specimen.css --minify",
    "specimen:watch": "tailwindcss -i specimen/specimen.css -o specimen/dist/specimen.css --watch"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "shadcn": "4.21.4",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@tailwindcss/cli": "4.3.3",
    "culori": "4.0.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
