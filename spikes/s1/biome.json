{
  "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
  "files": {
    "includes": [
      "lib/bakeoff.ts",
      "lib/scoring.ts",
      "lib/keyterms.ts",
      "lib/stt/**",
      "app/page.tsx",
      "app/auth/sign-in/page.tsx",
      "components/sign-in-form.tsx",
      "components/session-status.tsx",
      "public/voice-sw.js",
      "app/bakeoff/**",
      "app/api/bakeoff/**",
      "tests/bakeoff.test.mjs",
      "scripts/validate-live.mjs",
      "clips/clips.json",
      "lib/nlu/**",
      "config/**",
      "evals/**",
      "app/api/nlu/**",
      "tests/nlu*.mjs",
      "scripts/*nlu*.mjs",
      "lib/gateway/**",
      "lib/voice/**",
      "lib/verification/**",
      "app/voice/**",
      "app/api/voice/**",
      "app/settings/privacy/**",
      "app/api/privacy/**",
      "app/api/gateway/**",
      "components/privacy-controls.tsx",
      "tests/verification*.mjs",
      "scripts/gateway-*.mjs",
      "scripts/verification-*.mjs",
      "scripts/voice-*.mjs",
      "scripts/prepare-design-system.mjs"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
